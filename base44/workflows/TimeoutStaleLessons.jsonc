{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "timeout_stale_lessons",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "cleanup_stale_lessons": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "timeoutStaleLessons",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Encerrar aulas travadas",
            "description": "For\u00e7a conclus\u00e3o de aulas em in_progress h\u00e1 mais de 3h"
          }
        }
      }
    ]
  },
  "description": "Every 30 minutes, force-completes any lesson stuck in_progress for over 3 hours (forgotten calls), capping charged duration and clearing tutor in_lesson state.",
  "name": "Timeout Stale Lessons",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/30 * * * *",
      "one_time_date": null,
      "timezone": "America/Sao_Paulo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}