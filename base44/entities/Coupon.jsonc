{
  "name": "Coupon",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "Unique coupon code (uppercase)"
    },
    "credits_minutes": {
      "type": "number",
      "default": 10,
      "description": "Free minutes granted when coupon is used"
    },
    "max_uses": {
      "type": "number",
      "default": 100
    },
    "used_count": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "description": {
      "type": "string"
    },
    "affiliate_id": {
      "type": "string",
      "description": "ID do Affiliate vinculado a este cupom (opcional)"
    }
  },
  "required": [
    "code"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}