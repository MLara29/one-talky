{
  "name": "Affiliate",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "coupon_code": {
      "type": "string",
      "description": "C\u00f3digo de cupom exclusivo vinculado a este afiliado"
    },
    "commission_percent": {
      "type": "number",
      "default": 15,
      "description": "% de comiss\u00e3o sobre cada venda"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "pix_key": {
      "type": "string",
      "description": "Chave Pix para repasse"
    },
    "pix_key_type": {
      "type": "string",
      "enum": [
        "cpf",
        "email",
        "telefone",
        "aleatoria"
      ],
      "description": "Tipo da chave Pix"
    },
    "bank_info": {
      "type": "string",
      "description": "Informa\u00e7\u00f5es banc\u00e1rias adicionais (JSON)"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "full_name",
    "email",
    "coupon_code"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}