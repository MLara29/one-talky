{
  "name": "TutorProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Reference to User entity"
    },
    "full_name": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "nationality": {
      "type": "string"
    },
    "timezone": {
      "type": "string",
      "description": "IANA timezone of the tutor"
    },
    "native_languages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "other_languages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "language": {
            "type": "string"
          },
          "level": {
            "type": "string",
            "enum": [
              "basic",
              "intermediate",
              "advanced"
            ]
          }
        }
      }
    },
    "bio": {
      "type": "string",
      "maxLength": 300
    },
    "intro_video_url": {
      "type": "string"
    },
    "interests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "price_per_minute": {
      "type": "number",
      "default": 0.5
    },
    "availability": {
      "type": "object",
      "description": "Weekly availability schedule"
    },
    "booked_slots": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "is_available_now": {
      "type": "boolean",
      "default": false
    },
    "in_lesson": {
      "type": "boolean",
      "default": false,
      "description": "True while tutor is in an active video lesson"
    },
    "last_seen": {
      "type": "string",
      "format": "date-time",
      "description": "Last heartbeat timestamp \u2014 updated while tutor is logged in"
    },
    "accent": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "contract_type": {
      "type": "string",
      "enum": [
        "direct",
        "upwork"
      ],
      "default": "direct"
    },
    "total_lessons": {
      "type": "number",
      "default": 0
    },
    "total_minutes": {
      "type": "number",
      "default": 0
    },
    "average_rating": {
      "type": "number",
      "default": 0
    },
    "total_reviews": {
      "type": "number",
      "default": 0
    },
    "total_earnings": {
      "type": "number",
      "default": 0
    },
    "bank_info": {
      "type": "string"
    },
    "has_pending_withdrawal": {
      "type": "boolean",
      "default": false,
      "description": "CAS guard: true while a WithdrawalRequest (pending/processing) is outstanding for this tutor. Flips false->true atomically via updateMany in requestWithdrawal to prevent duplicate concurrent requests; cleared once the tutor confirms receipt (confirmWithdrawal)."
    },
    "min_booking_notice_hours": {
      "type": "number",
      "default": 0,
      "description": "Anteced\u00eancia m\u00ednima (em horas) exigida para um aluno agendar uma aula com este tutor. 0 = sem anteced\u00eancia m\u00ednima."
    },
    "tutor_agreement_accepted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp de aceite expl\u00edcito do Contrato de Presta\u00e7\u00e3o de Servi\u00e7o para Tutores, feito no onboarding. Separado do terms_accepted gen\u00e9rico do User."
    }
  },
  "required": [
    "full_name",
    "native_languages",
    "bio"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "student"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}