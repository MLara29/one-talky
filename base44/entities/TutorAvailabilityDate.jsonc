{
  "name": "TutorAvailabilityDate",
  "type": "object",
  "properties": {
    "tutor_id": {
      "type": "string",
      "description": "User id do tutor"
    },
    "date": {
      "type": "string",
      "description": "Data espec\u00edfica no formato YYYY-MM-DD, no fuso hor\u00e1rio do tutor. Cada registro representa a disponibilidade de UM dia espec\u00edfico \u2014 independente dos demais."
    },
    "slots": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Hor\u00e1rios dispon\u00edveis neste dia espec\u00edfico, no formato HH:MM (ex: 08:00, 14:30), no fuso hor\u00e1rio do tutor"
    }
  },
  "required": [
    "tutor_id",
    "date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.tutor_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.tutor_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "student"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tutor_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tutor_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}