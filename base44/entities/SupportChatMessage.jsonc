{
  "name": "SupportChatMessage",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "The app user (tutor/student) in this conversation \u2014 groups all messages in the thread"
    },
    "user_name": {
      "type": "string"
    },
    "user_role": {
      "type": "string",
      "enum": [
        "tutor",
        "student"
      ]
    },
    "is_from_admin": {
      "type": "boolean",
      "default": false,
      "description": "True when the admin sent this message; false when the user sent it"
    },
    "sender_name": {
      "type": "string",
      "description": "Display name of whoever sent this specific message"
    },
    "message": {
      "type": "string"
    },
    "is_read_by_admin": {
      "type": "boolean",
      "default": false,
      "description": "True when admin has opened/viewed this message. Used for unread badge count in the Messenger-style support page."
    }
  },
  "required": [
    "user_id",
    "user_name",
    "user_role",
    "is_from_admin",
    "sender_name",
    "message"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}