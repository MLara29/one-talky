{
  "name": "SupportTicketReply",
  "type": "object",
  "properties": {
    "ticket_id": {
      "type": "string",
      "description": "ID do SupportMessage pai (ticket) ao qual esta resposta pertence"
    },
    "ticket_owner_id": {
      "type": "string",
      "description": "sender_id do SupportMessage pai \u2014 usado no RLS para que o dono do ticket possa ler todas as respostas (suas e do admin) daquele ticket"
    },
    "sender_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio que enviou esta resposta"
    },
    "sender_name": {
      "type": "string",
      "description": "Nome de exibi\u00e7\u00e3o de quem enviou esta resposta"
    },
    "is_from_admin": {
      "type": "boolean",
      "default": false,
      "description": "True quando o admin enviou esta resposta; false quando o aluno/tutor enviou"
    },
    "message": {
      "type": "string"
    }
  },
  "required": [
    "ticket_id",
    "ticket_owner_id",
    "sender_id",
    "sender_name",
    "is_from_admin",
    "message"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.sender_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.ticket_owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}