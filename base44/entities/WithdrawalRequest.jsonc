{
  "name": "WithdrawalRequest",
  "type": "object",
  "properties": {
    "tutor_id": {
      "type": "string"
    },
    "tutor_name": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "period": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "paid",
        "rejected"
      ],
      "default": "pending"
    },
    "tutor_confirmed": {
      "type": "boolean",
      "default": false
    },
    "confirmed_at": {
      "type": "string",
      "format": "date-time"
    },
    "pioneer_email": {
      "type": "string"
    },
    "admin_comment": {
      "type": "string",
      "description": "Observa\u00e7\u00e3o do admin sobre esse pagamento espec\u00edfico (ex: valor extra pago, motivo de ajuste)."
    }
  },
  "required": [
    "tutor_id",
    "amount",
    "pioneer_email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "tutor"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.tutor_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}