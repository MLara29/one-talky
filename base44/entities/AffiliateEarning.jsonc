{
  "name": "AffiliateEarning",
  "type": "object",
  "properties": {
    "affiliate_id": {
      "type": "string",
      "description": "ID do registro Affiliate"
    },
    "student_id": {
      "type": "string"
    },
    "student_name": {
      "type": "string"
    },
    "coupon_code": {
      "type": "string"
    },
    "plan_id": {
      "type": "string",
      "description": "Ex: basic, standard, premium"
    },
    "sale_amount": {
      "type": "number",
      "description": "Valor total da venda"
    },
    "commission_percent": {
      "type": "number"
    },
    "commission_amount": {
      "type": "number",
      "description": "Valor da comiss\u00e3o"
    },
    "payment_id": {
      "type": "string",
      "description": "ID do pagamento no Mercado Pago"
    },
    "sale_date": {
      "type": "string",
      "format": "date-time"
    },
    "release_date": {
      "type": "string",
      "format": "date-time",
      "description": "Data de libera\u00e7\u00e3o (7 dias ap\u00f3s venda)"
    },
    "status": {
      "type": "string",
      "enum": [
        "aguardando_7_dias",
        "liberado",
        "pago"
      ],
      "default": "aguardando_7_dias"
    },
    "paid_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "affiliate_id",
    "student_id",
    "commission_amount",
    "payment_id"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "data.affiliate_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}