{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user",
        "student",
        "tutor",
        "affiliate"
      ],
      "default": "user"
    },
    "terms_accepted": {
      "type": "boolean",
      "default": false
    },
    "terms_accepted_at": {
      "type": "string",
      "format": "date-time"
    },
    "privacy_policy_accepted": {
      "type": "boolean",
      "default": false
    }
  }
}