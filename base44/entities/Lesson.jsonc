{
  "name": "Lesson",
  "type": "object",
  "properties": {
    "tutor_id": {
      "type": "string"
    },
    "student_id": {
      "type": "string"
    },
    "tutor_name": {
      "type": "string"
    },
    "student_name": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "in_progress",
        "completed",
        "cancelled",
        "no_show"
      ],
      "default": "scheduled"
    },
    "scheduled_at": {
      "type": "string",
      "format": "date-time"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_minutes": {
      "type": "number",
      "default": 0
    },
    "type": {
      "type": "string",
      "enum": [
        "instant",
        "scheduled"
      ],
      "default": "instant"
    },
    "is_recorded": {
      "type": "boolean",
      "default": false
    },
    "earnings_finalized": {
      "type": "boolean",
      "default": false,
      "description": "True once tutor earnings have been credited for this lesson \u2014 CAS guard to prevent double-payment."
    },
    "rate_applied": {
      "type": "number",
      "description": "Tutor's price_per_minute at the moment this lesson's earnings were finalized \u2014 historical rate, never recalculated later."
    },
    "earned_amount": {
      "type": "number",
      "description": "Tutor earnings for this lesson, computed once from rate_applied at finalization time. This is the auditable source of truth for tutor payouts \u2014 always sum this field, never re-derive with a tutor's current rate."
    },
    "flagged_for_review": {
      "type": "boolean",
      "default": false,
      "description": "True when the charged duration was capped (lesson ran or stayed open unusually long) \u2014 needs manual review."
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "tutor_id",
    "student_id",
    "language"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "student"
      }
    },
    "read": {
      "$or": [
        {
          "data.student_id": "{{user.id}}"
        },
        {
          "data.tutor_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}