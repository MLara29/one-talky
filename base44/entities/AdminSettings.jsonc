{
  "name": "AdminSettings",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Setting key, e.g. 'signup_notification_email'"
    },
    "value": {
      "type": "string"
    }
  },
  "required": [
    "key"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}