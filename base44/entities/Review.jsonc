{
  "name": "Review",
  "type": "object",
  "properties": {
    "lesson_id": {
      "type": "string"
    },
    "tutor_id": {
      "type": "string"
    },
    "student_id": {
      "type": "string"
    },
    "student_name": {
      "type": "string"
    },
    "student_photo": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "comment": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "author_role": {
      "type": "string",
      "enum": [
        "student",
        "tutor"
      ],
      "description": "Quem escreveu a avalia\u00e7\u00e3o: 'student' = aluno avaliando o tutor (p\u00fablica, aparece no perfil do tutor); 'tutor' = tutor avaliando o aluno (privada, vis\u00edvel apenas para o aluno avaliado e admin)."
    },
    "is_visible": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "tutor_id",
    "student_id",
    "rating",
    "author_role"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "student"
          }
        },
        {
          "user_condition": {
            "role": "tutor"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.author_role": {
                "$ne": "tutor"
              }
            },
            {
              "user_condition": {
                "role": "student"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.author_role": {
                "$ne": "tutor"
              }
            },
            {
              "user_condition": {
                "role": "tutor"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.author_role": "tutor"
            },
            {
              "data.student_id": "{{user.id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}