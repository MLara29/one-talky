{
  "name": "ClassroomMessage",
  "type": "object",
  "properties": {
    "lesson_id": {
      "type": "string"
    },
    "sender_id": {
      "type": "string"
    },
    "sender_name": {
      "type": "string"
    },
    "text": {
      "type": "string"
    }
  },
  "required": [
    "lesson_id",
    "sender_id",
    "text"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}