{
  "name": "StudentProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "nationality": {
      "type": "string"
    },
    "native_language": {
      "type": "string"
    },
    "target_language": {
      "type": "string"
    },
    "level": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ]
    },
    "objective": {
      "type": "string"
    },
    "accent_preference": {
      "type": "string"
    },
    "conversation_topics": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Favorite conversation topics selected by student",
      "default": []
    },
    "total_minutes": {
      "type": "number",
      "default": 0
    },
    "total_lessons": {
      "type": "number",
      "default": 0
    },
    "streak_days": {
      "type": "number",
      "default": 0
    },
    "last_practice_date": {
      "type": "string",
      "format": "date"
    },
    "last_seen": {
      "type": "string",
      "format": "date-time",
      "description": "Last heartbeat timestamp \u2014 updated while student is logged in. Used by the admin dashboard to count students online now (same pattern as TutorProfile.last_seen)."
    },
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "basic",
        "standard",
        "premium"
      ],
      "default": "free"
    },
    "credits_minutes": {
      "type": "number",
      "default": 0,
      "description": "DEPRECATED \u2014 mantido durante a transi\u00e7\u00e3o como soma de plan_credits_minutes + prepaid_credits_minutes + admin_gift_minutes. A fonte de verdade agora s\u00e3o os tr\u00eas campos separados. N\u00e3o usar para l\u00f3gica de neg\u00f3cio."
    },
    "plan_credits_minutes": {
      "type": "number",
      "default": 0,
      "description": "Minutos concedidos pelo plano mensal. Nunca expiram enquanto a assinatura estiver ativa. Ap\u00f3s cancelamento, ganham prazo de 60 dias (plan_credits_grace_expires_at). Consumidos depois de admin_gift_minutes em aulas."
    },
    "prepaid_credits_minutes": {
      "type": "number",
      "default": 0,
      "description": "Minutos comprados avulsos (pr\u00e9-pago) ou b\u00f4nus de cupom. Expiram 60 dias ap\u00f3s a compra (prepaid_expires_at). Cada nova compra de pacote reinicia o prazo para todo o saldo acumulado. Consumidos por \u00faltimo em aulas."
    },
    "prepaid_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data de expira\u00e7\u00e3o de TODO o saldo pr\u00e9-pago (comprado + b\u00f4nus). Resetada para agora+60 dias a cada compra de pacote. Pode ser diferente quando h\u00e1 b\u00f4nus de cupom com prazo pr\u00f3prio."
    },
    "admin_gift_minutes": {
      "type": "number",
      "default": 0,
      "description": "Minutos concedidos gratuitamente pelo admin via StudentDetailModal. Totalmente isolado de plan_credits_minutes e prepaid_credits_minutes \u2014 nunca afeta a expira\u00e7\u00e3o de cr\u00e9ditos pagos. Expira em 30 dias (admin_gift_expires_at). Consumido PRIMEIRO em aulas (antes de plan e prepaid), incentivando o uso r\u00e1pido do benef\u00edcio."
    },
    "admin_gift_granted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp da \u00faltima concess\u00e3o de minutos de presente pelo admin. Usado pelo lembrete semanal para determinar se o aluno j\u00e1 completou alguma aula desde que recebeu o benef\u00edcio."
    },
    "admin_gift_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data de expira\u00e7\u00e3o dos minutos de presente do admin (granted_at + 30 dias). O cron ExpireAdminGiftMinutes zera admin_gift_minutes quando esta data passa. Se uma nova concess\u00e3o ocorrer enquanto o saldo anterior ainda n\u00e3o expirou, mant\u00e9m a data MAIS distante entre a existente e agora+30d \u2014 nunca encurta um prazo j\u00e1 concedido."
    },
    "admin_gift_reminder_last_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp do \u00faltimo e-mail de lembrete semanal enviado sobre minutos de presente n\u00e3o usados. O cron SendFreeMinutesReminders s\u00f3 envia um novo lembrete se este campo for vazio ou tiver 7+ dias."
    },
    "plan_credits_grace_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Setado s\u00f3 quando a assinatura \u00e9 cancelada (agora + 60 dias). Nulo enquanto ativa \u2014 o rel\u00f3gio s\u00f3 come\u00e7a a contar depois do cancelamento. O cron expirePlanGraceCredits zera plan_credits_minutes quando esta data passa."
    },
    "coupon_code": {
      "type": "string",
      "description": "C\u00f3digo do cupom usado no onboarding"
    },
    "subscription_start_date": {
      "type": "string",
      "format": "date-time",
      "description": "Data de in\u00edcio do primeiro ciclo de assinatura ativa"
    },
    "subscription_valid_until": {
      "type": "string",
      "format": "date-time",
      "description": "Data at\u00e9 quando o acesso \u00e9 v\u00e1lido ap\u00f3s cancelamento fora da janela de 7 dias."
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "none",
        "active",
        "cancelled",
        "expired"
      ],
      "default": "none",
      "description": "Status atual da assinatura"
    },
    "subscription_cycle": {
      "type": "number",
      "default": 0,
      "description": "N\u00famero do ciclo atual (0 = sem assinatura, 1 = primeiro m\u00eas, 2+ = meses seguintes)"
    },
    "subscription_provider": {
      "type": "string",
      "enum": [
        "stripe",
        "mercadopago"
      ],
      "description": "Provedor de pagamento da assinatura ativa. Determina qual API cancelar ao chamar cancelMyPlan."
    },
    "stripe_subscription_id": {
      "type": "string",
      "description": "ID da assinatura no Stripe (sub_xxx). Preenchido pelo stripeWebhook quando uma assinatura \u00e9 criada via checkout."
    },
    "mp_payment_id": {
      "type": "string",
      "description": "ID do pagamento na Mercado Pago, usado para processar reembolso se necess\u00e1rio."
    },
    "stripe_payment_intent_id": {
      "type": "string",
      "description": "ID do Payment Intent na Stripe, usado para processar reembolso se necess\u00e1rio."
    },
    "cancelled_within_guarantee": {
      "type": "boolean",
      "default": false,
      "description": "Marca se o cancelamento aconteceu dentro dos 7 dias de garantia (Art. 49 CDC), com reembolso processado."
    },
    "first_week_lesson_id": {
      "type": "string",
      "description": "ID da Lesson agendada na janela dos primeiros 7 dias do ciclo 1. '__pending__:<token>' enquanto em andamento; ID real ap\u00f3s commit. Lock CAS anti-race-condition."
    },
    "first_week_lock_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp de aquisi\u00e7\u00e3o do lock pendente. Locks expirados (TTL) s\u00e3o tratados como \u00f3rf\u00e3os e podem ser sobrescritos."
    },
    "is_blocked": {
      "type": "boolean",
      "default": false,
      "description": "True quando o admin bloqueou o acesso do aluno \u00e0 plataforma. Independente do campo plan \u2014 nunca usar plan para representar bloqueio."
    }
  },
  "required": [
    "full_name",
    "native_language",
    "target_language",
    "level"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}