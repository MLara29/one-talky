{
  "name": "StudentProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "nationality": {
      "type": "string"
    },
    "native_language": {
      "type": "string"
    },
    "target_language": {
      "type": "string"
    },
    "level": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ]
    },
    "objective": {
      "type": "string"
    },
    "accent_preference": {
      "type": "string"
    },
    "conversation_topics": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Favorite conversation topics selected by student",
      "default": []
    },
    "total_minutes": {
      "type": "number",
      "default": 0
    },
    "total_lessons": {
      "type": "number",
      "default": 0
    },
    "streak_days": {
      "type": "number",
      "default": 0
    },
    "last_practice_date": {
      "type": "string",
      "format": "date"
    },
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "basic",
        "standard",
        "premium"
      ],
      "default": "free"
    },
    "credits_minutes": {
      "type": "number",
      "default": 0
    },
    "coupon_code": {
      "type": "string",
      "description": "C\u00f3digo do cupom usado no onboarding"
    },
    "subscription_start_date": {
      "type": "string",
      "format": "date-time",
      "description": "Data de in\u00edcio do primeiro ciclo de assinatura ativa"
    },
    "subscription_valid_until": {
      "type": "string",
      "format": "date-time",
      "description": "Data at\u00e9 quando o acesso \u00e9 v\u00e1lido ap\u00f3s cancelamento fora da janela de 7 dias."
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "none",
        "active",
        "cancelled",
        "expired"
      ],
      "default": "none",
      "description": "Status atual da assinatura"
    },
    "subscription_cycle": {
      "type": "number",
      "default": 0,
      "description": "N\u00famero do ciclo atual (0 = sem assinatura, 1 = primeiro m\u00eas, 2+ = meses seguintes)"
    },
    "first_week_lesson_id": {
      "type": "string",
      "description": "ID da Lesson agendada na janela dos primeiros 7 dias do ciclo 1. '__pending__:<token>' enquanto em andamento; ID real ap\u00f3s commit. Lock CAS anti-race-condition."
    },
    "first_week_lock_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp de aquisi\u00e7\u00e3o do lock pendente. Locks expirados (TTL) s\u00e3o tratados como \u00f3rf\u00e3os e podem ser sobrescritos."
    },
    "is_blocked": {
      "type": "boolean",
      "default": false,
      "description": "True quando o admin bloqueou o acesso do aluno \u00e0 plataforma. Independente do campo plan \u2014 nunca usar plan para representar bloqueio."
    }
  },
  "required": [
    "full_name",
    "native_language",
    "target_language",
    "level"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "affiliate"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}