{
  "name": "StudentProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "nationality": {
      "type": "string"
    },
    "native_language": {
      "type": "string"
    },
    "target_language": {
      "type": "string"
    },
    "level": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ]
    },
    "objective": {
      "type": "string"
    },
    "accent_preference": {
      "type": "string"
    },
    "conversation_topics": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Favorite conversation topics selected by student",
      "default": []
    },
    "total_minutes": {
      "type": "number",
      "default": 0
    },
    "total_lessons": {
      "type": "number",
      "default": 0
    },
    "streak_days": {
      "type": "number",
      "default": 0
    },
    "last_practice_date": {
      "type": "string",
      "format": "date"
    },
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "basic",
        "standard",
        "premium"
      ],
      "default": "free"
    },
    "credits_minutes": {
      "type": "number",
      "default": 15
    },
    "coupon_code": {
      "type": "string",
      "description": "C\u00f3digo do cupom usado no onboarding (para aplicar comiss\u00e3o de afiliado em compras futuras)"
    }
  },
  "required": [
    "full_name",
    "native_language",
    "target_language",
    "level"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "tutor"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "affiliate"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}