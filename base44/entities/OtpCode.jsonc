{
  "name": "OtpCode",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "used": {
      "type": "boolean",
      "default": false
    },
    "session_token": {
      "type": "string",
      "description": "The otp_session_token active on the User at the moment this code was issued. verifyOtp requires this to match the User's current otp_session_token, so a code from a superseded login session can never verify a newer one."
    },
    "attempts": {
      "type": "number",
      "default": 0,
      "description": "Contador de tentativas malsucedidas de verifica\u00e7\u00e3o deste c\u00f3digo. Ap\u00f3s 5 tentativas, o c\u00f3digo \u00e9 invalidado (used=true) e a pessoa precisa pedir um novo via sendOtp."
    }
  },
  "required": [
    "user_id",
    "email",
    "code",
    "expires_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}