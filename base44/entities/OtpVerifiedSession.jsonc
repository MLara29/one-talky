{
  "name": "OtpVerifiedSession",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "session_hash": {
      "type": "string",
      "description": "SHA-256 hash of the bearer token of the specific browser session that completed OTP verification. Never store the raw token."
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Matches the session's own JWT expiry when available, so a verified session can never outlive its token."
    }
  },
  "required": [
    "user_id",
    "session_hash",
    "expires_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}